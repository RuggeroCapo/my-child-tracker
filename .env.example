# URL e chiave pubblica (anon/publishable) del progetto Supabase.
# In locale: `npx supabase start` stampa entrambi i valori.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Mostra "Continua con Google" (richiede il provider Google configurato su Supabase).
VITE_ENABLE_GOOGLE_AUTH=false
